#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Dragonfruit display-manager session entry (T-12.2).
#
# This is the `Exec` of share/wayland-sessions/dragonfruit.desktop. It is the
# one owner of session startup and logout teardown:
#
#   1. export the T-12.1b session environment (base + a fresh launch token)
#      and import it into the systemd user manager;
#   2. start dragonfruit-session.target, whose units are the production
#      supervisor;
#   3. block until the compositor anchor exits (a crash ends the session by
#      design, and the display manager returns);
#   4. stop the target, clear any failed units, and remove the session's
#      private runtime hand-off files, so the next login starts clean.
#
# It only ever talks to *our* user units: the host DE, its compositor, and the
# display manager are never touched.
#
# Overridable for tests and non-standard layouts:
#   DF_SESSION_BIN     the dragonfruit-session binary (default /usr/bin/...)
#   DF_SESSION_SOCKET  the private socket name (default dragonfruit-wayland)
#   DF_SESSION_TARGET  the user target to start/stop
#   DF_SYSTEMCTL       the systemctl to use (default systemctl)
#   DF_SESSION_START_TIMEOUT  seconds to wait for the compositor socket (30)
#   DRAGONFRUIT_SESSION_ENV   extra environment file to source
set -eu

session_bin="${DF_SESSION_BIN:-/usr/bin/dragonfruit-session}"
socket="${DF_SESSION_SOCKET:-dragonfruit-wayland}"
target="${DF_SESSION_TARGET:-dragonfruit-session.target}"
systemctl="${DF_SYSTEMCTL:-systemctl}"
start_timeout="${DF_SESSION_START_TIMEOUT:-30}"

# The native dev installer writes the runtime library paths the built tree
# links against (the repo's Qt toolchain and user-space sysroot). A packaged
# build does not need it; a dev login does, because the display manager does
# not inherit `make`'s LD_LIBRARY_PATH. Source the first file that exists; the
# file's LD_LIBRARY_PATH is also pinned on the Dragonfruit units by a per-user
# drop-in, so it never has to be imported into the manager itself.
home_dir="${HOME:-/nonexistent}"
for candidate in \
    "${DRAGONFRUIT_SESSION_ENV:-}" \
    "${XDG_CONFIG_HOME:-$home_dir/.config}/dragonfruit/native.env" \
    "$home_dir/.config/dragonfruit/native.env"; do
    [ -n "$candidate" ] || continue
    if [ -r "$candidate" ]; then
        set -a
        # shellcheck disable=SC1090
        . "$candidate"
        set +a
        break
    fi
done

# 1. The session environment. `--print-env` prints KEY=VALUE lines for the
#    base variables plus a fresh DRAGONFRUIT_LAUNCH_TOKEN; `eval` puts them in
#    this shell, then the user manager carries them to every unit.
eval "$("$session_bin" --print-env --socket-name "$socket")"

# Third-party toolkit defaults: GTK-family CSD apps read their window-control
# layout from the toolkit settings, not from the compositor. Apply the
# desktop's left-side layout before any app can launch. Best-effort — the
# settings.ini/keyfile fallbacks are written even when gsettings is absent.
# `--print-env` also exported GTK_CSD=0 above, which asks GTK 3 on
# X11/Xwayland to use server-side decorations so the compositor draws the
# traffic lights. Wayland GTK 3 uses the compositor's KDE default mode.
"$session_bin" --sync-toolkit >/dev/null 2>&1 || true

# An installed session carries its QML modules under the install prefix; a
# display-manager login has no build tree and no dev-tool environment, so the
# shell and every first-party app would otherwise exit before mapping a window.
# The dev installer also writes the build tree's module root into native.env,
# which is sourced above; keep both search roots.
session_prefix="$(CDPATH= cd -- "$(dirname -- "$session_bin")/.." 2>/dev/null && pwd || true)"
if [ -n "$session_prefix" ] && [ -d "$session_prefix/share/dragonfruit/qml" ]; then
    QML_IMPORT_PATH="${QML_IMPORT_PATH:+$QML_IMPORT_PATH:}$session_prefix/share/dragonfruit/qml"
    QML2_IMPORT_PATH="${QML2_IMPORT_PATH:-$QML_IMPORT_PATH}"
    export QML_IMPORT_PATH QML2_IMPORT_PATH
fi

# User units inherit the user manager's environment, so importing the session
# identity is what makes it reach the compositor (libseat/logind uses
# XDG_SESSION_ID to pick the right session). The dev-build loader path is
# deliberately *not* imported here: it is pinned per unit by a drop-in so it
# can never leak into the host desktop's user manager.
"$systemctl" --user import-environment \
    XDG_CURRENT_DESKTOP XDG_SESSION_TYPE WAYLAND_DISPLAY \
    DISPLAY GTK_CSD DRAGONFRUIT_LAUNCH_TOKEN DRAGONFRUIT_DESKTOP_LAUNCH_TOKEN \
    DRAGONFRUIT_DEV_RETURN DRAGONFRUIT_DEV_BIN \
    XDG_SESSION_ID XDG_SESSION_DESKTOP XDG_SESSION_CLASS XDG_SESSION_PATH \
    XDG_VTNR XDG_SEAT QML_IMPORT_PATH QML2_IMPORT_PATH

# A package upgrade (or a dev install) can add or replace user units while the
# user manager is already running. Reload before starting the target so the
# next login runs the installed units, not a stale cached copy.
"$systemctl" --user daemon-reload >/dev/null 2>&1 || true

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# Remove hand-off files a previous, crashed login may have left. Doing this
# before the readiness gate is what makes the gate meaningful: a stale socket
# must not make a failed compositor look healthy.
rm -f \
    "$runtime/$socket" \
    "$runtime/$socket.lock" \
    "$runtime/$socket.x11-display" \
    "$runtime/$socket.launch-token" \
    "$runtime/$socket.desktop-launch-token"

# 2. Start the target (the units are the supervisor).
if ! "$systemctl" --user start "$target"; then
    printf 'dragonfruit-session-entry: %s failed to start\n' "$target" >&2
    "$systemctl" --user status --no-pager "$target" dragonfruit-compositor.service >&2 || true
    exit 1
fi

# Readiness gate. Type=simple returns before the compositor has bound the
# socket, and a compositor that dies immediately would otherwise leave the
# display manager on a black screen forever. Wait for the socket, then stay
# on the anchor-exit loop below as usual.
socket_path="$runtime/$socket"
deadline=$(( $(date +%s) + start_timeout ))
while [ ! -e "$socket_path" ]; do
    state="$("$systemctl" --user is-active dragonfruit-compositor.service 2>/dev/null || true)"
    case "$state" in
        active|activating|reloading) ;;
        *)
            printf 'dragonfruit-session-entry: the compositor is not running (%s) before creating %s\n' \
                "${state:-unknown}" "$socket_path" >&2
            "$systemctl" --user status --no-pager dragonfruit-compositor.service >&2 || true
            "$systemctl" --user stop "$target" >/dev/null 2>&1 || true
            exit 1
            ;;
    esac
    if [ "$(date +%s)" -ge "$deadline" ]; then
        printf 'dragonfruit-session-entry: timed out waiting for %s (%ss)\n' "$socket_path" "$start_timeout" >&2
        "$systemctl" --user status --no-pager dragonfruit-compositor.service >&2 || true
        "$systemctl" --user stop "$target" >/dev/null 2>&1 || true
        exit 1
    fi
    sleep 0.25
done

# 3. Wait for the anchor. The compositor is the session's anchor: when it
#    exits, the session is over and the display manager returns.
while "$systemctl" --user is-active --quiet dragonfruit-compositor.service; do
    sleep 0.5
done

# 4. Logout teardown. Stopping the target stops every unit through each
#    unit's PartOf=; `reset-failed` clears the anchor's failed state so the
#    next login starts from scratch. The compositor removes its own hand-off
#    files on a clean exit; this is the safety net after a crash.
"$systemctl" --user stop "$target" || true
# The portal frontend is pulled in as a dependency of the portal backend but
# is PartOf=graphical-session.target, which is not our target; stop it
# explicitly so no portal process outlives the session.
"$systemctl" --user stop xdg-desktop-portal.service >/dev/null 2>&1 || true
"$systemctl" --user reset-failed "$target" || true

rm -f \
    "$runtime/$socket" \
    "$runtime/$socket.lock" \
    "$runtime/$socket.x11-display" \
    "$runtime/$socket.launch-token" \
    "$runtime/$socket.desktop-launch-token"
