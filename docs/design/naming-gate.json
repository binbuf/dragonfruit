    { "term": "Macintosh", "replacement": "system / computer", "pattern": "\\bMacintosh\\b" },
    { "term": "Mac", "replacement": "system / computer", "pattern": "\\bMac\\b" },
    { "term": "Apple", "replacement": "Dragonfruit", "pattern": "\\bApple\\b", "notes": "No Apple branding or product names in the UI." },
    { "term": "Apple menu", "replacement": "System menu", "pattern": "\\bApple menu\\b" },
    { "term": "Finder", "replacement": "Files", "pattern": "\\bFinder\\b" },
    { "term": "Launchpad", "replacement": "Applications", "pattern": "\\bLaunchpad\\b" },
