    { "term": "Stage Manager", "replacement": "Stage", "pattern": "\\bStage Manager\\b" },
    { "term": "System Settings", "replacement": "Settings", "pattern": "\\bSystem Settings\\b" },
    { "term": "System Preferences", "replacement": "Settings", "pattern": "\\bSystem Preferences\\b" },
