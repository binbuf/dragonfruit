{
  "schema": 1,
  "status": "normative",
  "updated": "2026-11-07",
  "description": "Machine-readable gate vocabulary for the user-facing naming map in interface-naming-and-licensing.md. The human map remains normative; this file lists the Apple terms that must not appear in user-facing strings, desktop entries, or packaging metadata. A line carrying `df-allow-name` is exempt (negative tests and deliberate history).",
  "sources": [
    "QML qsTr() strings and bare user-visible property literals",
    "C++ tr(), QCoreApplication::translate(), QT_TR_NOOP(), and QStringLiteral/QLatin1String labels",
    "*.desktop values",
    "packaging/ metadata and manifests"
  ],
